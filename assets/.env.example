# --- Aplicación ---
APP_NAME=mi-api
APP_ENV=development
APP_PORT=3000
PUBLIC_API_URL=http://localhost:3000

# --- Base de datos ---
# Apunta a la base de CONTROL y sirve de plantilla para las bases de tenant:
# el provisioning reemplaza el nombre de la base por tenant_<slug>_<id>.
#
# PostgreSQL:
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app_control?sslmode=disable
#
# MongoDB (replica set de un nodo, necesario si vas a usar transacciones):
# DATABASE_URL=mongodb://localhost:27017/app_control?replicaSet=rs0&directConnection=true

# --- Autenticación ---
# Genera uno con: openssl rand -hex 32
JWT_SECRET=cambia-esto-por-un-secreto-de-32-bytes
JWT_ISSUER=mi-api
JWT_EXPIRATION_MINUTES=60

# --- Arranque ---
# Corta el arranque si la base no responde, en vez de quedarse colgado en el deploy.
STARTUP_TIMEOUT_SECONDS=30

# --- Cifrado de secretos en base (opcional) ---
# 32 bytes en hex (64 caracteres): openssl rand -hex 32
# SECRET_ENCRYPTION_KEY=

# --- Correo (opcional) ---
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=no-reply@ejemplo.cl
